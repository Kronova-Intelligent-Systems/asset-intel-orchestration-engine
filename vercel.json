{
  "version": 2,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "DISABLE_CACHE": "1",
      "NEXT_TELEMETRY_DISABLED": "1",
      "TURBOPACK": "1"
    }
  },
  "crons": [
    { "path": "/api/cron/sync-ai-models",        "schedule": "0 6 1,15 * *" },
    { "path": "/api/cron/deactivate-stale-models","schedule": "0 7 1 * *"   }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "app/api/supabase/edge-functions/route.ts": {
      "runtime": "vercel/nodejs@22.10.0"
    },
    "app/api/supabase/functions/*.ts": {
      "runtime": "vercel/nodejs@22.10.0"
    }
  },
  "headers": [
    {
      "source": "supabase/functions/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, x-client-info, apikey"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "app/api/supabase/edge-functions/(.*)",
      "destination": "/supabase/functions/$1"
    }
  ],
  "installCommand": "rm -rf .next node_modules/.cache && rm -f bun.lockb package-lock.json yarn.lock && bun install --no-cache --force",
  "buildCommand": "rm -rf .next && bun run build",
  "devCommand": "bun run dev",
  "framework": "nextjs",
  "regions": ["iad1"]
}
